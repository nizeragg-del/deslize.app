STRIPE_PRICE_PRO=price_12345
STRIPE_PRICE_AGENCY=price_12345

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Puppeteer / Browserless (para exportar os PNGs)
